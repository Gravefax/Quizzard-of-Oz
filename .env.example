# =============================================================================
# Postgres / Docker
# =============================================================================
POSTGRES_CONTAINER_NAME=quizbattle-db
POSTGRES_DB=quizbattle
POSTGRES_USER=quizbattle
POSTGRES_PASSWORD=1pw4postgres!
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Optional: Aktivieren Sie die Ausgabe der SQL-Befehle, die von SQLAlchemy generiert werden
ECHO_DATABASE=False

# =============================================================================
# Session / Cookies (Backend Auth)
# =============================================================================
SESSION_EXP_MINUTES=2160
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=localhost
SESSION_COOKIE_NAME=quizbattle_session

# =============================================================================
# Trivia API integration
# =============================================================================
TRIVIA_API_BASE_URL=https://the-trivia-api.com
TRIVIA_API_KEY=
TRIVIA_TIMEOUT_SECONDS=5
TRIVIA_MAX_RETRIES=2
TRIVIA_BACKOFF_SECONDS=0.25
TRIVIA_REFILL_ATTEMPTS=3
TRIVIA_REFILL_BATCH_SIZE=20
TRIVIA_MAX_LIMIT=50
TRIVIA_BREAKER_FAIL_MAX=5
TRIVIA_BREAKER_RESET_TIMEOUT=30

# =============================================================================
# CORS (Backend) - JSON-Liste oder kommaseparierte Origins
# =============================================================================
CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# Keycloak (Backend)
# =============================================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=quizzard

# Keycloak Admin (wird vom keycloak-Container in docker-compose verwendet)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# =============================================================================
# Frontend (Next.js)
# =============================================================================
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=quizzard
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=quizzard-frontend

# Backend-URL fuer Next.js rewrites (vom Server aus erreichbar)
BACKEND_URL=http://localhost:8000
# Interne Keycloak-URL fuer Next.js rewrites (/auth Tunnel)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# Basis-URLs fuer API- und WebSocket-Aufrufe aus dem Browser
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Optional secret used by app/api/protected/route.ts (mainly for tests)
API_SECRET=secret-token
