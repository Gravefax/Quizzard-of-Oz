# Postgres / Docker
POSTGRES_CONTAINER_NAME=quizbattle-db
POSTGRES_DB=quizbattle
POSTGRES_USER=quizbattle
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Optional: Aktivieren Sie die Ausgabe der SQL-Befehle, die von SQLAlchemy generiert werden
ECHO_DATABASE=False

SESSION_EXP_MINUTES=2160
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=localhost
SESSION_COOKIE_NAME=quizbattle_session

# Trivia API integration
TRIVIA_API_BASE_URL=https://the-trivia-api.com
TRIVIA_API_KEY=
TRIVIA_TIMEOUT_SECONDS=5
TRIVIA_MAX_RETRIES=2
TRIVIA_BACKOFF_SECONDS=0.25
TRIVIA_REFILL_ATTEMPTS=3
TRIVIA_REFILL_BATCH_SIZE=20
TRIVIA_MAX_LIMIT=50
TRIVIA_BREAKER_FAIL_MAX=5
TRIVIA_BREAKER_RESET_TIMEOUT=30

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=quizzard
