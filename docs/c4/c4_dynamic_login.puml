@startuml C4_Dynamic_Login
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml

LAYOUT_WITH_LEGEND()

title Dynamic View - Login and Backend Session\nQuizzard of Oz

Person(user, "Registered player", "Starts login in the browser.")
Container(frontend, "Next.js frontend", "Next.js / React / keycloak-js", "Runs the OIDC client and stores display auth state.")
Container(backend, "FastAPI backend", "FastAPI / PyJWT", "Verifies Keycloak tokens and manages application sessions.")
ContainerDb(database, "PostgreSQL", "PostgreSQL", "Stores users and backend sessions.")
System_Ext(keycloak, "Keycloak", "OIDC identity provider", "Owns identity and exposes JWKS.")

Rel(user, frontend, "1. Clicks login", "HTTPS")
Rel(frontend, keycloak, "2. Starts Authorization Code + PKCE", "HTTPS")
Rel(keycloak, user, "3. Shows login / registration form", "HTTPS")
Rel(keycloak, frontend, "4. Redirects back with authorization code", "HTTPS")
Rel(frontend, keycloak, "5. Exchanges code for access token", "HTTPS")
Rel(keycloak, frontend, "6. Returns Keycloak access token", "JWT")
Rel(frontend, backend, "7. POST /auth/login with Authorization: Bearer token", "HTTP JSON")
Rel(backend, keycloak, "8. Retrieves JWKS and verifies token", "HTTPS")
Rel(backend, database, "9. Finds or creates User by keycloak_sub", "SQL")
Rel(backend, database, "10. Creates Session with expires_at", "SQL")
Rel(backend, frontend, "11. Returns user data and sets HttpOnly session cookie", "HTTP Set-Cookie")
Rel(frontend, frontend, "12. Stores display credentials in Zustand", "Browser state")
Rel(frontend, user, "13. Shows authenticated navigation state", "HTTPS")

@enduml
