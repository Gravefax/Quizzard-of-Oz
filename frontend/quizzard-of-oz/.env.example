# Required for Google OAuth login. In Portainer, set this in container env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here
# Server-side fallback used by runtime-config endpoint.
GOOGLE_CLIENT_ID=your_client_id_here
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Optional secret used by app/api/protected/route.ts (mainly for tests)
API_SECRET=secret-token